# ==============================================================================
# Azure Secure File Storage and Sharing System - Configuration Environment Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual Azure Storage credentials.
# NEVER commit your real '.env' file or Azure secrets into Git repository!

# Flask Application Secret Key (Used to cryptographically sign session cookies)
# Generate a strong key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Flask Environment (development | production)
FLASK_ENV=development
PORT=5000

# ==============================================================================
# Microsoft Azure Blob Storage Configuration
# ==============================================================================
# Obtain this connection string from Azure Portal:
# Azure Portal -> Storage Accounts -> [Your Storage Account] -> Security + Networking -> Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account_name;AccountKey=your_storage_account_access_key;EndpointSuffix=core.windows.net

# Target Private Azure Blob Storage Container Name
AZURE_STORAGE_CONTAINER_NAME=secure-files-container

# Maximum Allowed File Upload Size (in Megabytes)
MAX_CONTENT_LENGTH_MB=25

# ==============================================================================
# Demo & Evaluation Users (JSON Format for multi-user isolation in Azure Storage)
# Each user receives an isolated folder prefix in Azure Blob Storage: <username>/<filename>
# ==============================================================================
APP_USERS={"student": "azurepass123", "faculty": "cloudpass456", "admin": "adminpass789"}

# Fallback Single Demo Account (if APP_USERS is not JSON parsed)
DEFAULT_USERNAME=student
DEFAULT_PASSWORD=azurepass123
